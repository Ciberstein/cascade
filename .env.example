# Dónde caen las descargas, en el host. Cada paquete crea su subcarpeta.
DOWNLOAD_DIR=./downloads
# Sin login: por defecto solo escucha en esta máquina. Cambiar a 0.0.0.0 abre
# Cascade a toda la red local, donde cualquiera podría encolar descargas y
# cambiar la carpeta de destino.
BIND_ADDRESS=127.0.0.1
